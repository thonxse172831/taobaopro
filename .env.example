# Tuỳ chọn: mật khẩu tài khoản admin (mặc định tài khoản thanhngancao / test123, nên đổi khi deploy)
ADMIN_PASSWORD=doi-mat-khau-manh-o-day
# Bắt buộc: chuỗi kết nối MongoDB Atlas (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=taobaopro
# Chuỗi ngẫu nhiên dài để ký phiên đăng nhập (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
# Secret cho webhook hãng vận chuyển (POST /api/webhook/ghn?secret=...). Để trống = tắt webhook
WEBHOOK_SECRET=
# API key webhook SePay (tự xác nhận tiền cọc chuyển khoản). Để trống = shop xác nhận cọc bằng tay
SEPAY_API_KEY=
# Cổng chạy (nhiều hosting tự cấp biến PORT)
PORT=3000
# Số proxy đứng trước app (1 nếu sau Nginx/Cloudflare/Render/Railway)
TRUST_PROXY=
# Tên miền được phép gọi API, cách nhau bằng dấu phẩy (chỉ cần khi proxy đổi header Host)
ALLOWED_ORIGINS=
